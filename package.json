{
  "name": "lj-s-tutoring",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sentry/react": "^10.56.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-router-dom": "^6.30.4",
    "sonner": "^2.0.7",
    "split-type": "^0.3.4"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cpy-cli": "^5.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "html-validate": "9.7.1",
    "http-server": "14.1.1",
    "husky": "^9.1.7",
    "linkinator": "7.6.1",
    "npm-run-all": "^4.1.5",
    "pa11y-ci": "4.1.1",
    "postcss": "^8.4.49",
    "rimraf": "^5.0.5",
    "supabase": "2.111.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "8.0.5"
  },
  "overrides": {
    "vitest": "3.2.6"
  },
  "scripts": {
    "clean": "rimraf dist",
    "dev:react": "vite --config vite.app.config.ts --host 0.0.0.0 --port 5173",
    "build:react": "vite build --config vite.app.config.ts",
    "build:static": "node scripts/build-static.js",
    "build:css": "tailwindcss -c tailwind.config.js -i ./assets/tailwind-input.css -o ./dist/assets/tailwind-input.css --minify",
    "inject:config": "node scripts/inject-config.js",
    "verify:static-assets": "node scripts/verify-static-assets.js",
    "build": "npm run build:react && npm run build:static && npm run build:css && npm run inject:config && npm run verify:static-assets",
    "serve": "node scripts/serve-static.js",
    "start:static": "npm run serve",
    "start": "npm run start:static",
    "dev:static": "npm run build:static && npm run build:css && npm run inject:config && npm run serve",
    "dev": "npm run dev:static",
    "supabase:start": "npx supabase start",
    "supabase:legacy-baseline:overwrite": "node scripts/sync-supabase-migration.cjs --overwrite-frozen-baseline",
    "supabase:reset": "npx supabase db reset --local",
    "supabase:status": "npx supabase status",
    "supabase:types:check": "node scripts/check-supabase-type-drift.cjs",
    "supabase:types:update": "node scripts/check-supabase-type-drift.cjs --update",
    "test:frontend:unit": "node scripts/run-frontend-tests.cjs",
    "test:rls": "node --test tests/frontend/supabase-schema-policy.test.cjs tests/frontend/assignment-versioning-locking.test.cjs tests/frontend/multi-org-rls-isolation.test.cjs tests/frontend/allocation-contract-fields.test.cjs tests/frontend/sessions-migration.test.cjs tests/frontend/finance-payroll-migration.test.cjs tests/frontend/weekly-reports-notifications-migration.test.cjs tests/frontend/tutor-onboarding-migration.test.cjs tests/frontend/growth-risk-monitoring-migration.test.cjs tests/frontend/academic-extras-volunteering-migration.test.cjs tests/frontend/rls-recursion-safety.test.cjs tests/frontend/permission-gate-null-safety.test.cjs tests/frontend/transactional-onboarding-rate-limit.test.cjs",
    "test:rls:runtime": "npx supabase test db",
    "verify:supabase:roles": "node scripts/verify-supabase-dashboard-access.cjs",
    "test:release:evidence": "node --test tests/release-evidence.test.cjs",
    "test:e2e": "playwright test --config playwright.react.config.ts",
    "test:e2e:supabase": "node scripts/run-local-supabase-e2e.cjs",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:ui": "playwright test --config playwright.react.config.ts --ui",
    "test:unit": "npm run test:frontend:unit",
    "test:all": "npm run test:unit",
    "test": "npm run test:all",
    "typecheck:react": "tsc --noEmit -p tsconfig.app.json",
    "typecheck": "npm run typecheck:react",
    "perf:budget": "node scripts/check-frontend-performance-budget.cjs",
    "perf:lighthouse": "lhci autorun --config=./lighthouserc.js",
    "validate:monitoring": "node scripts/validate-monitoring-assets.js",
    "lint:js": "eslint \"assets/**/*.js\" \"scripts/**/*.js\" --max-warnings=0",
    "lint:react": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:html": "html-validate \"*.html\"",
    "lint": "npm-run-all --parallel lint:js lint:react lint:html",
    "qa:serve": "http-server dist -p 8080 -c-1 --silent",
    "qa:wait": "wait-on http://localhost:8080/ --timeout 60000",
    "qa:html": "html-validate \"dist/**/*.html\" --config .htmlvalidate.js",
    "qa:links": "linkinator http://localhost:8080/ http://localhost:8080/about http://localhost:8080/programs http://localhost:8080/guides http://localhost:8080/guides/matric-maths-mistakes-guide http://localhost:8080/privacy http://localhost:8080/terms http://localhost:8080/dashboard/login --recurse --timeout 10000 --concurrency 4 --skip \"^mailto:|^tel:|^https?:\\/\\/(?!localhost:8080)\"",
    "qa:a11y": "pa11y-ci",
    "prepare": "husky || echo husky-not-installed"
  }
}
