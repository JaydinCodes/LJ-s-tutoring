# Copy to `.env.local` for local development. Keep placeholders only and never
# commit real secrets. VITE_* values are compiled into the browser bundle.

# Public Supabase browser configuration. The local defaults come from
# `npm run supabase:status`; the anon key is public, the service-role key is not.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace_with_local_anon_key_from_supabase_status

# Local-only UI controls. Production builds ignore the MFA bypass and the
# Playwright config enables the mock adapter itself during `npm run test:e2e`.
VITE_PO_DEV_ADMIN_MFA_BYPASS=false
VITE_E2E_AUTH_MOCK=false
VITE_E2E_AUTH_PASSWORD=ProjectOdysseus!23

# Optional browser error reporting. Missing/disabled configuration is valid.
# Never put a private Sentry auth token in a VITE_* value.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_RELEASE=
VITE_SENTRY_SAMPLE_RATE=1

# Edge Function/server-only configuration. These values must never be exposed to
# browser code or committed with real credentials. Hosted Supabase supplies its
# own URL and service-role key; set the Groq values as Edge Function secrets.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key_from_supabase_status
APP_INVITE_REDIRECT_URL=http://localhost:5173/dashboard/login
# Production-only role-specific callback URLs. Leave unset locally so every
# invite returns to the shared local login page above.
APP_ADMIN_INVITE_REDIRECT_URL=
APP_TUTOR_INVITE_REDIRECT_URL=
APP_STUDENT_INVITE_REDIRECT_URL=
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
# Vision-capable model for grade-submission (Groq's model above is text-only).
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Local migration verification only. Never point reset/test commands at the
# production project or database.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_TEST_PROJECT_REF=local
SUPABASE_PRODUCTION_PROJECT_REF=

# Compatibility output for the retained static portal-config asset. The active
# React app uses Supabase directly; PUBLIC_PO_API_BASE is not an auth/data API.
PUBLIC_PO_API_BASE=/api
ASSISTANT_ENABLED=true
